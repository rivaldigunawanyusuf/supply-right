# ============================================
# SupplyRight AI — Environment Variables
# ============================================
# Copy to .env and fill in values. NEVER commit .env!

# Ethereum Sepolia RPC
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# OR: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer / Agent wallet private key (TESTNET ONLY — no real funds!)
# This key is used ONLY by the isolated signer, never exposed to the LLM
AGENT_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE

# Buyer wallet private key (TESTNET ONLY)
BUYER_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE

# Provider wallet private key (TESTNET ONLY)
PROVIDER_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE

# Verifier wallet private key (TESTNET ONLY)
VERIFIER_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE

# Registrar wallet private key (TESTNET ONLY)
REGISTRAR_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_HERE

# Chain
CHAIN_ID=11155111

# LLM API Key (for AI agent)
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
# OR: GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# Backend
BACKEND_PORT=3001
FRONTEND_PORT=5173

# Etherscan (for contract verification, optional)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY_HERE
